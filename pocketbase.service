[Unit]
Description=Pocketbase

[Service]
Type  = simple
User  = root
Group = root
LimitNOFILE = 4096
Restart = always
RestartSec = 5s
StandardOutput = append:/root/pb/errors.log
StandardError = append:/root/pb/errors.log
ExecStart = /root/pb/pocketbase serve --https="r319c7uoppfpk2dt.h-gac.com:443"

[Install]
WantedBy = multi-user.target
